generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  OP_MANAGER
  WEB_DEVELOPER
  SOFTWARE_DEVELOPER
  DIGITAL_MARKETER
  CONTENT_CREATOR
  VIDEO_EDITOR
  ADMIN
  CEO
  BDM
  SALES_HEAD
  BDE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  HOT
}

enum FollowupStatus {
  PENDING
  COMPLETED
  MISSED
  CANCELLED
}

enum AppointmentStatus {
  PENDING
  SCHEDULED
  CONFIRMED
  APPROVED
  DECLINED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  users     User[]
  teams     Team[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  services    String[] @default([])
}

model Team {
  id             String       @id @default(cuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        User[]
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  passwordHash   String
  name           String
  phone          String?
  avatarUrl      String?
  status         UserStatus   @default(ACTIVE)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  managerId String?
  manager   User?   @relation("UserHierarchy", fields: [managerId], references: [id])
  reports   User[]  @relation("UserHierarchy")

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id])

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  passwordChangedAt   DateTime  @default(now())

  // Gamification
  xp              Int       @default(0)
  streak          Int       @default(0)
  lastActiveDate  DateTime?

  sessions  Session[]
  auditLogs AuditLog[]
  chatMemberships ChatMember[]
  chatMessages    ChatMessage[]

  assignedLeads        Lead[]        @relation("LeadAssignee")
  createdLeads         Lead[]        @relation("LeadCreator")
  assignedCustomers    Customer[]    @relation("CustomerOwner")
  assignedFollowups    Followup[]    @relation("FollowupAssignee")
  createdFollowups     Followup[]    @relation("FollowupCreator")
  assignedAppointments Appointment[] @relation("AppointmentAssignee")
  assignedTasks        Task[]        @relation("TaskAssignee")
  taskComments         TaskComment[]
  createdTasks         Task[]        @relation("TaskCreator")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([roleId])
  @@index([managerId])
  @@index([teamId])
  @@index([status])
  appointmentsRequested   Appointment[]  @relation("AppointmentRequester")
  appointmentsFor         Appointment[]  @relation("AppointmentFor")
  appointmentsApproved    Appointment[]  @relation("AppointmentApprover")
  timeBlocks              TimeBlock[]    @relation("TimeBlockUser")
  timeBlocksCreated       TimeBlock[]    @relation("TimeBlockCreator")
}

model Role {
  id          String           @id @default(cuid())
  name        RoleName         @unique
  level       Int
  description String?
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  module      String
  action      String
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Session {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHash String
  userAgent   String?
  ipAddress   String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Lead {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  email          String?
  phone          String?
  company        String?
  source         String?
  status         LeadStatus   @default(NEW)
  priority       LeadPriority @default(MEDIUM)
  value          Decimal?     @db.Decimal(14, 2)
  notes          String?
  tags           String[]

  assignedToId String?
  assignedTo   User?   @relation("LeadAssignee", fields: [assignedToId], references: [id])
  createdById  String
  createdBy    User    @relation("LeadCreator", fields: [createdById], references: [id])

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  followups    Followup[]
  appointments Appointment[]
  activities   Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([assignedToId])
  @@index([status])
  @@index([priority])
  service  String?
}

model Customer {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String?
  phone          String?
  company        String?
  address        String?
  notes          String?
  tags           String[]

  ownerId String?
  owner   User?   @relation("CustomerOwner", fields: [ownerId], references: [id])

  leads        Lead[]
  projects     Project[]
  documents    Document[]
  activities   Activity[]
  appointments Appointment[]
  followups    Followup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([ownerId])
}

model Followup {
  id             String         @id @default(cuid())
  organizationId String
  title          String
  notes          String?
  dueAt          DateTime
  status         FollowupStatus @default(PENDING)
  completedAt    DateTime?
  result         String?

  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  assignedToId String?
  assignedTo   User?   @relation("FollowupAssignee", fields: [assignedToId], references: [id])
  createdById  String
  createdBy    User    @relation("FollowupCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([assignedToId])
  @@index([dueAt])
  @@index([status])
}

model Appointment {
  id             String            @id @default(cuid())
  organizationId String
  title          String
  description    String?
  startAt        DateTime
  endAt          DateTime
  status         AppointmentStatus @default(SCHEDULED)
  location       String?

  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  assignedToId String?
  assignedTo   User?   @relation("AppointmentAssignee", fields: [assignedToId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([assignedToId])
  @@index([startAt])
  requestedById String?
  requestedBy   User?   @relation("AppointmentRequester", fields: [requestedById], references: [id])
  forUserId     String?
  forUser       User?   @relation("AppointmentFor", fields: [forUserId], references: [id])
  approverId    String?
  approver      User?   @relation("AppointmentApprover", fields: [approverId], references: [id])
  approvedAt    DateTime?
  declineReason String?
}

model TimeBlock {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  user           User     @relation("TimeBlockUser", fields: [userId], references: [id])
  date           DateTime
  startAt        DateTime
  endAt          DateTime
  reason         String?
  createdById    String
  createdBy      User     @relation("TimeBlockCreator", fields: [createdById], references: [id])
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([userId, date])
  @@index([startAt])
}


model Task {
  id             String       @id @default(cuid())
  organizationId String
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  dueAt          DateTime?
  reminderAt     DateTime?
  reminderFiredAt DateTime?
  completedAt    DateTime?

  assignedToId String?
  assignedTo   User?   @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdById  String
  createdBy    User    @relation("TaskCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([assignedToId])
  comments     TaskComment[]
  checklist    TaskChecklistItem[]

  @@index([status])
}

model Project {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  description    String?
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

model Document {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  url            String
  mimeType       String?
  size           Int?
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id])

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([customerId])
}

model Activity {
  id             String   @id @default(cuid())
  organizationId String
  type           String
  title          String
  body           String?
  metadata       Json?
  userId         String

  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([leadId])
  @@index([customerId])
  @@index([userId])
}

model Notification {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  type           String
  title          String
  body           String?
  data           Json?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId])
  @@index([readAt])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([taskId])
}

model TaskChecklistItem {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text      String
  done      Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([taskId])
}

// ═══════════════════════════════════════════════════════════
// iFChat — real-time messaging (DM + Groups)
// ═══════════════════════════════════════════════════════════

model Chat {
  id             String        @id @default(cuid())
  organizationId String
  name           String?       // null for 1:1 DMs
  isGroup        Boolean       @default(false)
  createdById    String
  members        ChatMember[]
  messages       ChatMessage[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
  @@index([updatedAt])
}

model ChatMember {
  id         String   @id @default(cuid())
  chatId     String
  chat       Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt   DateTime @default(now())
  lastReadAt DateTime @default(now())

  @@unique([chatId, userId])
  @@index([userId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([chatId, createdAt])
}

// ═══════════════════════════════════════════════════════════
// Configuration — Tags, Categories, Sources, etc.
// ═══════════════════════════════════════════════════════════

model ConfigItem {
  id             String   @id @default(cuid())
  organizationId String
  type           String   // tag | lead_category | status | lead_source | dead_reason
  name           String
  color          String?  // hex color like "#ef4444" (used for tags)
  order          Int      @default(0)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, type, name])
  @@index([organizationId, type])
}
